 ],
 "id": "cases/evolve-jintrac-iter-5ma-lmode",
 "type": "fyo:ScenarioSpecification",
 "title": {
  "zh": "JINTRAC 5 MA L-mode · 芯—边耦合（本仓跑不动；源里也没跑完）",
  "en": "JINTRAC 5 MA L-mode - core-edge coupling (this repository cannot run it; nor did the source finish it)"
 },
 "note": {
  "zh": "★★两重「跑不动」，要分开说。**本仓**跑不动，因为它整条判据都在 SOL / 偏滤器 / 中性粒子上，而本仓只有芯部。**源文档自己也没跑完**：EDGE2D 在 3.510495 s 撞上最小时间步（time-step stiffness）停住，而芯部快照已经推到约 295.788 s——所以这一档在源里也是 INCOMPLETE，它的表值是**一帧快照**，不是一个稳态解。★源文档原话记着这件事：「Snapshot evidence alone does not establish a stationary detached solution.」——照抄进来，免得下一个人把快照当成脱靶稳态的证据。",
  "en": "★★Two different「cannot run」, and they must be told apart. THIS REPOSITORY cannot run it because its whole acceptance lives in the SOL / divertor / neutrals and this repository has only the core. THE SOURCE DID NOT FINISH IT EITHER: EDGE2D stalled at its minimum time step (3.510495 s, time-step stiffness) while the core snapshot had advanced to ~295.788 s -- so the case is INCOMPLETE there too, and its tabulated values are ONE SNAPSHOT, not a steady solution. ★The source says so in its own words -- 'Snapshot evidence alone does not establish a stationary detached solution' -- copied here so the next reader does not take the snapshot for evidence of a detached steady state."
 },
 "prescribed_task_kind": "fyo:PhysicsModelingTask",
 "prescribes_code": {
  "id": "code/evolve",
  "type": "spo:Code",
  "name": "fylite",
  "comment": "capability `evolve` of the fylite tool register (python/fylite/scenario/__init__.py TOOLS['evolve']); the parameter IRIs `code/evolve#<name>` are this capability's control vocabulary"
 },
 "about_discharge": {
  "type": "fyo:Discharge",
  "performed_on": {
   "type": "fyo:Tokamak",
   "title": {
    "en": "ITER"
   }
  }
 },
 "inputs": [
  {
   "type": "spo:PortBinding",
   "binds_port": {
