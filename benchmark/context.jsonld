{
  "@context": {
    "@version": 1.1,

    "fyo":  "https://fusion-yun.github.io/fyo/latest/",
    "spo":  "https://fusion-yun.github.io/spo/latest/",
    "bfo":  {"@id": "http://purl.obolibrary.org/obo/BFO_", "@prefix": true},
    "sp":   "https://w3id.org/spdata/v1/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd":  "http://www.w3.org/2001/XMLSchema#",

    "id":   "@id",
    "type": "@type",

    "title":    "rdfs:label",
    "abstract": "rdfs:comment",
    "comment":  "rdfs:comment",
    "recorded": {"@id": "spo:creation_date", "@type": "xsd:date"},
    "caveat":   {"@id": "spo:caveat", "@container": "@set"},

    "comparison_kind":    {"@id": "fyo:comparison_kind"},
    "compared_subject":   {"@id": "fyo:compared_subject"},
    "compared_reference": {"@id": "fyo:compared_reference", "@container": "@set"},
    "scenario":           {"@id": "spo:about_information_object", "@type": "@id"},
    "criteria":           {"@id": "fyo:has_criterion", "@container": "@list"},
    "findings":           {"@id": "fyo:has_finding", "@container": "@list"},
    "assertion_state":    {"@id": "spo:assertion_state"},
    "overall_verdict":    {"@id": "fyo:overall_verdict"},
    "run":                {"@id": "spo:generated_by_process"},
    "account":            {"@reverse": "bfo:0000059"},
    "report":             {"@reverse": "bfo:0000059"},

    "quantity_label":   {"@id": "fyo:quantity_label"},
    "norm":             {"@id": "fyo:norm"},
    "norm_note":        {"@id": "fyo:norm_note"},
    "tolerance":        {"@id": "fyo:tolerance"},
    "tolerance_basis":  {"@id": "fyo:tolerance_basis"},
    "null_hypothesis":  {"@id": "fyo:null_hypothesis"},
    "about_criterion":  {"@id": "fyo:about_criterion", "@type": "@id"},
    "measured_deviation": {"@id": "fyo:measured_deviation"},
    "deviation_literal":  {"@id": "fyo:deviation_literal"},
    "verdict":          {"@id": "fyo:verdict"},
    "finding_kind":     {"@id": "fyo:finding_kind"},

    "name":          {"@id": "spo:name"},
    "version":       {"@id": "spo:version"},
    "license":       {"@id": "spo:license"},
    "uses_library":  {"@id": "spo:uses_library", "@container": "@set"},
    "declares_port": {"@id": "spo:declares_port", "@container": "@set"},
    "port_name":     {"@id": "spo:port_name"},
    "port_direction": {"@id": "spo:port_direction"},
    "realizes":      {"@id": "spo:realizes", "@container": "@set"},
    "has_input":     {"@id": "spo:has_input", "@container": "@set"},
    "storage_uri":   {"@id": "spo:storage_uri"},
    "format_iri":    {"@id": "spo:format_iri", "@type": "@id"},
    "checksum":      {"@id": "spo:checksum"},
    "numeric_value": {"@id": "spo:numeric_value"},
    "has_unit":      {"@id": "spo:has_unit"},
    "ucum_code":     {"@id": "spo:ucum_code"},
    "provenance_class": {"@id": "sp:provenance_class"},
    "quality_state":    {"@id": "sp:quality_state"},

    "about_discharge": {"@id": "fyo:about_discharge"},
    "pulse_number":    {"@id": "fyo:pulse_number"},
    "performed_on":    {"@id": "fyo:performed_on"},
    "over_time_axis":  {"@id": "fyo:over_time_axis"},
    "samples":         {"@id": "spo:samples", "@container": "@list"},
    "state":           {"@id": "spo:has_port_binding", "@container": "@set"},
    "bound_to":        {"@id": "spo:bound_to"},
    "ip_A":    {"@id": "fyo:global_quantities/ip"},
    "b0_T":    {"@id": "fyo:vacuum_toroidal_field/b0"},
    "r0_m":    {"@id": "fyo:vacuum_toroidal_field/r0"},
    "a_m":     {"@id": "fyo:boundary/minor_radius"},
    "kappa":   {"@id": "fyo:boundary/elongation"},
    "delta":   {"@id": "fyo:boundary/triangularity"},
    "species": {"@id": "fyo:ion", "@container": "@set"}
  }
}
