          "bounds": [
            {
              "quantity": "SUMMARY/q95",
              "minimum": 2.0
            },
            {
              "quantity": "SUMMARY/greenwald",
              "maximum": 1.2
            },
            {
              "quantity": "SUMMARY/beta_n",
              "maximum": 4.0
            }
          ],
          "caveat": [
            "三条都是常用运行限（见册子抬头的注记），不是某份参考件的实测值"
          ]
        },
        {
          "type": "fyo:AcceptanceCriterion",
          "quantity_label": "energy-balance",
          "norm": "relative",
          "tolerance": {
            "type": "spo:QuantityValue",
            "numeric_value": 0.05
          },
          "tolerance_basis": "measured_band"
        }
      ]
    },
    {
