      ]
    },
    {
      "id": "physics/equilibrium-gfile",
      "title": {
        "zh": "一份盘上的平衡产出（合成 g-file）：Grad–Shafranov 与几何定义",
        "en": "An equilibrium product on disk (synthetic g-file): Grad–Shafranov and the geometric definitions"
      },
      "abstract": {
        "zh": "判的是**产出文件**而不是一次运行：一份 g-file 就是一份平衡产出，它满不满足 GS 与谁写的它无关。★这一条在没有内核的检出里也跑得动，因此本册子不会整册都是「未评估」。",
        "en": "This row judges a product on disk rather than a run, so it is evaluable in a public checkout with no kernel."
      },
      "product": [
        {
          "type": "spo:Concretization",
          "storage_uri": "rust/fylite_data/testdata/g_synthetic.geqdsk",
          "format_iri": "https://fusion-yun.github.io/fyo/latest/GeqdskFormat",
          "comment": "本仓自带的合成 g-file（数据层的判据件）"
        }
      ],
      "criteria": [
        {
          "type": "fyo:AcceptanceCriterion",
          "quantity_label": "grad-shafranov",
          "norm": "relative",
          "tolerance": {
            "type": "spo:QuantityValue",
            "numeric_value": 0.05
          },
          "tolerance_basis": "measured_band",
          "caveat": [
            "带宽按网格取：g-file 的 ψ 在 65×65 上，二阶差分的截断误差随 h² 走"
          ]
        }
      ],
      "caveat": [
        "合成件不是一次物理放电：它是数据层的判据件，用来把这条通路本身钉住"
      ]
    }
  ]
