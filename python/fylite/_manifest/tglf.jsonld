  "fylite:acceptance": {
    "@note": "★the ported face returns growth rates and quasi-linear fluxes and does not search the mode width (its caveat says so). A per-run criterion would be「did the eigenvalue solve converge」, which the port does not report.",
    "gamma": {
      "tbd": "growth rates are the ANSWER, not a quality metric; what would be scored is the eigen-solve's own convergence, which is not reported"
    }
  },
  "fylite:tool": "tglf",
  "fylite:ports": {
    "in": [
      {
        "port_id": "equilibrium",
        "label": "local geometry source",
        "data_type": "fyo:equilibrium"
      },
      {
        "port_id": "core_profiles",
        "label": "local kinetic parameters",
        "data_type": "fyo:core_profiles"
      }
    ],
    "out": [
      {
        "port_id": "fluxes",
        "label": "turbulent fluxes",
        "data_type": "fyo:core_transport"
      }
    ]
  },
  "fylite:argument_shapes": {
    "inputs": {
      "required": [
        "NS",
        "WIDTH"
      ],
      "note": "a TGLF input deck under upstream's parameter names. WIDTH is required BY DESIGN: libtglf bisects for the mode width and this port does not — it will not guess one for you"
    }
  },
