  "fylite:entry": "fylite.scenario.analysis.loop:self_consistent",
  "fylite:acceptance": {
    "converged": {
      "require": true
    },
    "@note": "the self-consistent loop's own |Δq0| < tol verdict. ★The reconstruction criteria (`terror`/`chi_pressure`) are NOT repeated here: each round's reconstruction is its own recorded run and carries them."
  },
  "fylite:executable_note": "Callable again since 2026-08-25. Two things had to change and both did: the FSA-current constraint this loop states went into the kernel (ABI v113 `gs_inverse_solve_fsa`), so `loop.self_consistent` binds to a real reconstruction door instead of the departed EFIT driver's signature; and the loop stopped reading its equilibrium back off a g-file path, which the in-memory reconstruction does not produce — it hands the result straight to `fyo.as_equilibrium`. Measured on this checkout, the tool now fails at the distribution boundary (`ModuleNotFoundError: MDSplus`), which is the honest one: the shot tree is not shipped. It remains a workflow TEMPLATE — a plan an engine runs — and the tool face carries it because its entry is a real, invocable composition of the artifacts it names.",
  "fylite:ports": {
    "in": [
      {
        "port_id": "measurements",
        "label": "measurement set",
        "data_type": "fyo:magnetics"
      }
    ],
    "out": [
      {
        "port_id": "equilibrium",
        "label": "converged equilibrium",
        "data_type": "fyo:equilibrium"
      },
      {
        "port_id": "core_profiles",
        "label": "converged profiles",
        "data_type": "fyo:core_profiles"
      }
    ]
  },
