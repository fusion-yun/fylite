 "fylite:switches": {
  "only_magnetic": {
   "kin": false,
   "neon": false,
   "probefit": false,
   "pointfit": false,
   "farfit": false,
   "vesselfit": false
  },
  "kinetic": {
   "kin": true,
   "neon": true,
   "probefit": false,
   "pointfit": true,
   "farfit": false,
   "vesselfit": false
  }
 },
 "caveat": {
  "zh": "磁测量单独约束不住内部剖面；正向算子只有磁通环与探针一支，弦积分族缺席。",
  "en": "Magnetics alone do not constrain the internal profiles; the forward operator has flux loops and probes only, no line integrals."
 },
 "parameters": [
  {
   "type": "spo:ParameterSetting",
   "sets_parameter": "code/reconstruction#basis",
   "literal_value": "delivered"
  },
  {
   "type": "spo:ParameterSetting",
   "sets_parameter": "code/reconstruction#maxit",
   "literal_value": 800
  }
 ]
