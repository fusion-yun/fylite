{
 "@context": [
  "../context.jsonld"
 ],
 "id": "scenario/reconstruction",
 "type": "fyo:ScenarioSpecification",
 "title": {
  "zh": "平衡反演",
  "en": "Equilibrium reconstruction"
 },
 "note": {
  "zh": "场景模板：`fy run <线> reconstruction` 的参数表与端口声明。GENERATED by tools/make-scenario-templates.py — 词表逐条取自语料的 code/reconstruction#<名> IRI，不要手改。",
  "en": "Scenario template: the parameter table and ports of `fy run <line> reconstruction`. GENERATED by tools/make-scenario-templates.py — the vocabulary is lifted from the corpus's own code/reconstruction#<name> IRIs; do not hand-edit."
 },
 "prescribed_task_kind": "fyo:ExperimentAnalysisTask",
 "prescribes_code": {
  "id": "code/reconstruction",
  "type": "spo:Code",
  "name": "fylite"
 },
 "fylite:lines": [
  "analysis"
 ],
 "fylite:ports": {
  "device": {
   "requires": "manifest",
   "type": "fyo:DeviceDescription",
   "ids": [
    "pf_active",
    "wall",
    "magnetics",
    "tf"
   ]
  },
  "measurements": {
   "primary": true,
   "ids": [
    "magnetics",
    "pf_active",
    "tf"
   ]
  },
  "pressure": {
   "optional": true,
   "note": "the profile scenario's product; one carrying `derived-from-reconstruction` provenance is refused"
  }
 },
 "fylite:common": [
  "shot",
  "time",
  "provider",
  "epoch"
 ],
 "fylite:time": "point",
 "fylite:vocabulary": {
  "basis": {
   "type": "choice",
   "choices": [
