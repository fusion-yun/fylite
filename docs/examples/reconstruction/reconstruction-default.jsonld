 "id": "cases/reconstruction-default",
 "type": "fyo:ScenarioSpecification",
 "title": {
  "zh": "合成孪生反演（出厂设置）",
  "en": "Synthetic-twin reconstruction (as shipped)"
 },
 "note": {
  "zh": "★S-1 提取档（2026-08-26）：由 analysis.html 的出厂控件值机械提取，不是页面导出的会话文件——接线后应由页面导出替换以完成往返校验。内容：合成孪生反演的完整旋钮（Ip 450 kA・β 0.60・噪声 0.005・种子 7 的合成测量，动理学约束开，逐项拟合开关与权重照出厂）。`npp`/`nff` 两个基函数阶下拉由页面按装置在运行时填充，HTML 里没有诚实的缺省，故本档不含——套用时留给页面自己的值。",
  "en": "★S-1 extraction (2026-08-26): mechanically lifted from analysis.html factory control values, NOT a page-exported session file — once the bar is wired, replace with a page export to close the round trip. Contents: the full knob set of the synthetic-twin reconstruction (synthetic measurements at Ip 450 kA, β 0.60, noise 0.005, seed 7; kinetic constraint on; per-diagnostic fit switches and weights as shipped). The `npp`/`nff` basis-order selects are filled at runtime per device and have no honest HTML default, so this file omits them — applying leaves the page's own values."
 },
 "prescribed_task_kind": "fyo:ExperimentAnalysisTask",
 "prescribes_code": {
  "id": "code/reconstruction",
  "type": "spo:Code",
  "name": "fylite",
  "comment": "capability `reconstruction` of the fylite tool register (python/fylite/scenario/__init__.py TOOLS['reconstruction']); the parameter IRIs `code/reconstruction#<name>` are this capability's control vocabulary"
 },
 "about_discharge": {
  "type": "fyo:Discharge",
  "performed_on": {
   "type": "fyo:Tokamak",
   "title": {
    "en": "EAST"
   },
   "described_by": {
    "id": "machine_desc/east",
    "type": "fyo:MachineDescription"
   }
  }
 },
