              "norm": "relative",
              "tolerance_basis": "measured_band",
              "tolerance_note": "带在第一次实测后定；事前写下的带只会被凑上"
            },
            {
              "type": "fyo:AcceptanceCriterion",
              "quantity_label": "q95 · 体积 · 边界外形",
              "tolerance_basis": "reference_stated",
              "tolerance_note": "取参考自报精度；参考未自报时本项记未评估，不自拟带"
            }
          ],
          "status": "blocked-unknown",
          "caveat": [
            "本体在 $ITER_SCENARIO_ROOT（1.7 GB，ITER IDM Internal Use），未取回；取回前本条不可执行。"
          ]
        },
        {
