 "title": {
  "zh": "台基反馈收敛到 EPED1-NN 目标；内核的 EPED1-NN 对 EPEDNN.jl 逐位（8.9e-16）",
  "en": "The pedestal feedback settles on the EPED1-NN target; the kernel's EPED1-NN matches EPEDNN.jl to 8.9e-16"
 },
