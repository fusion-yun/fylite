 "id": "benchmark/records/eq-convention-gfile-cocos-roundtrip",
 "type": "fyo:ComparisonRecord",
 "title": {
  "zh": "g-file 口径：读—写—再读是不动点，量出的 COCOS 不动，两套读者逐位一致",
  "en": "G-file conventions: the read-write-read fixed point, a stable measured COCOS, two readers agreeing bit for bit"
 },
 "domain": "eq-convention",
 "requirement": [
  "NR-EQ-001",
  "NR-EQ-006"
 ],
 "comparison_kind": "verification",
 "overall_verdict": "pass",
 "compared_subject": {
  "type": "spo:Code",
  "name": "fylite",
  "comment": "`fylite.io.geqdsk` 的读写与 `measure_cocos`，以及内核数据层的 `kernel.read_gfile`"
 },
 "compared_reference": [
  {
   "type": "spo:InformationContentEntity",
   "name": "恒等式：写之后再读，必须回到原处",
   "comment": "★**参考是它自己**——往返是一条恒等式，不是一份外部答案。所以容差取**机器精度**，不取物理带：物理带会把「写入端换了一个数」这类偏差整个盖住。"
  },
  {
   "type": "spo:Code",
   "name": "同一读取函数的另一实现（Python 定宽参照读者 ↔ Rust 数据层读者）",
   "comment": "★两份实现读的是**同一串十进制文本**，所以判据是**逐位相同**而不是「近似」。任何一位差都说明有一侧切错了位置——那不是容差问题。"
  }
 ],
 "criteria": [
  {
   "id": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/1",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "往返后每个数值字段的最劣相对偏差",
   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 1e-09
   },
   "tolerance_basis": "machine_precision"
  },
  {
   "id": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/2",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "头一行经一次往返是否逐字不变",
   "norm": "absolute",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0
   },
   "tolerance_basis": "machine_precision",
   "comment": "★★**单独判，不并进上一条。** g-file 没有版本号，头一行是它唯一的自述（谁写的、哪一炮、哪一时刻）。并成一条的话，「25 个字段全对」会把它盖住——而 2026-09-08 那次唯一的缺陷恰恰只在这一行（写入端把 `idum` 写死成 0）。"
  },
  {
   "id": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/3",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "量出来的 COCOS 口径是否因往返而变",
   "norm": "absolute",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0
   },
   "tolerance_basis": "machine_precision",
   "comment": "★COCOS 是**量出来**的（`measure_cocos`），不是读标签读来的；标签是离散值，判等不判带。"
  },
  {
   "id": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/4",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "两套读者对同一份件的每个标量与数组元素",
   "norm": "absolute",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0
   },
   "tolerance_basis": "machine_precision",
   "comment": "逐位相同，不是近似"
  }
 ],
 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "往返：每个数值字段",
   "criterion": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/1",
   "deviation_literal": "合成件 0（25 个字段）· EAST #70754 0（25 个字段）——两者皆为**精确零**",
   "verdict": "pass",
   "caveat": [
    "★偏差是 0 而不是「小于 1e-9」：往返走的是同一串十进制文本，本就该逐位回来。若哪天它变成 1e-12，那不是「仍然很好」，是写入端开始重新格式化数字了。"
   ],
   "measured_deviation": 0.0,
   "bound": "upper"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "往返：头一行",
   "criterion": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/2",
   "deviation_literal": "合成件不变 · EAST 不变（`EFITD    08/02/2006    # 70754  5000ms           3 129 129`）",
   "verdict": "pass",
   "caveat": [
    "★这一条是 2026-09-08 唯一失手的地方，修在 `format_geqdsk`。它留在册上不是纪念，是因为**写入端最容易再犯的就是这一处**。"
   ],
   "bound": "identity"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "往返：量出的 COCOS",
   "criterion": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/3",
   "deviation_literal": "两份件的口径均不变；EAST 侧量到 psi_axis=minimum · sign_ip=+1 · sign_b0=+1 · sign_q=+1 · dpsi, per radian（残差 0.07288，次优解差 11.5 倍）",
   "verdict": "pass",
   "caveat": [
    "★**裕度 11.5 倍值得记**：它说明这次判读不是在两个口径之间勉强择一，而是次优解差了一个数量级。裕度小的时候，同一条「口径不变」的判据含金量完全不同。"
   ],
   "bound": "identity"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "两套读者逐位一致",
   "criterion": "benchmark/records/eq-convention-gfile-cocos-roundtrip/criterion/4",
   "deviation_literal": "合成件 13 标量 + 10 数组 / 4922 个元素逐位相同；EAST #70754 13 标量 + 10 数组 / 17600 个元素逐位相同；差异字段：无",
   "verdict": "pass",
   "bound": "identity"
  }
 ],
 "validity_domain": "两份语料各答一问：**仓内合成件**（`rust/fylite_runtime/testdata/g_synthetic.geqdsk`，65x65，构造已知、永远在场）与**一份真炮**（EAST #70754 @ 5000 ms，129x129，来自 fydoc 算例书 FYDOC-CASE-19）。★真炮件里有合成件挑不出的东西：列宽、负号吃空格、老写法。只用合成件会把这些漏掉。★比较落在 g-file 的 25 个数值字段 / 13 个标量 + 10 个数组上；COCOS 由 `measure_cocos` 在**文件自己的边界多边形之内**量出。",
 "caveat": [
  "★★**本条不判任何物理**。它问的是「本仓的读与写互为逆」「两套读者读出同一串数」，不是「这份 g-file 的平衡对不对」。口径对齐是**跨码比较的前置条件**，不是结论——别的记录引本条，是为了说明它们的数放在一起可比。",
  "★**真炮件是实验类指针**：它住在 fydoc 检出里（本仓不带真炮 g-file），读数里记的是绝对路径 + sha256。换一台机器要设 `$FYDOC_DIR`；够不到时门按名 skip，**不拿合成件顶替**——顶替会让这条判据在缺了一半语料时仍显示绿色。",
  "★**往返闭合不保证写出去的文件对别的码可读**。它只保证本仓自洽。对外部 EFIT/CHEASE 读者的可读性是另一件事，本域尚无记录。"
 ],
