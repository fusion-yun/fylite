   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.01
   },
   "tolerance_basis": "measured_band",
   "comment": "★★2026-09-19 改判法（正对照）：参考分离面是 METIS 数字化曲线，它是否在这台机器的额定与本设计的剖面族之内，事先不知道——拿它判设计，判的是目标与设计两件事的合。正对照把两件分开：已知额定内电流（额定内设计电流 × 0.97）正解出一条分离面，设计从缺省起点去复原它，再正解设计的电流。1 % 不动。"
  }
 ],
 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "分离面对参考曲线的闭合（无界设计，防劣化带）",
   "criterion": "benchmark/records/eq-inverse-iter-reference-separatrix/criterion/1",
   "measured_deviation": 15.157469027494539,
