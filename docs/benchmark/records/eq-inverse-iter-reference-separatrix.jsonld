 "type": "fyo:ComparisonRecord",
 "title": {
  "zh": "ITER 参考分离面上的静态逆解：在 DINA 额定内收敛、守额定；对机器做得到的分离面复原 kappa · delta_lower 到 0.3 %——参考分离面差的 3 % / 10 % 是目标的，不是设计的",
  "en": "Static inverse on the ITER reference separatrix: converged within the DINA ratings; on a separatrix the machine can make it recovers kappa and delta_lower to 0.3 % — the reference's 3 % / 10 % shortfall is the target's, not the design's"
 },
 "domain": "eq-inverse",
 "requirement": [
  "FR-EQ-005"
 ],
 "comparison_kind": "verification",
 "overall_verdict": "pass",
