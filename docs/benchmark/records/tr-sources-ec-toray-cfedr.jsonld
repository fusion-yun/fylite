 "type": "fyo:ComparisonRecord",
 "title": {
  "zh": "EC 对 TORAY-GA（CFEDR 20 MA）：偏振支由数据读出，射线同面差 0.6 mm、N∥ 差 1.5e-04，沉积峰差 0.012（不到一壳），驱动电流每瓦 1.046 倍",
  "en": "EC against TORAY-GA (CFEDR 20 MA): the branch read off the data, the ray within 0.6 mm on matched surfaces, N∥ within 1.5e-04, the deposition peak 0.012 apart (under one shell), driven current per watt 1.046×"
 },
 "domain": "tr-sources",
 "requirement": [
  "FR-TR-004"
 ],
 "comparison_kind": "benchmark",
 "overall_verdict": "pass",
 "compared_subject": {
  "type": "spo:Code",
  "name": "fylite · code/rf_ray（冷等离子体射线 + 相对论吸收 + 伴随 ECCD）",
  "comment": "TORAY 那一次运行的平衡（psiin，SI）、剖面（echin）与发射几何，原样喂进树门"
 },
 "compared_reference": [
  {
   "type": "spo:Code",
   "name": "TORAY-GA",
   "version": "CFEDR H-mode 20 MA 设计点（fydoc CASE-21，OMFIT 树 CFEDR_260114）：输入 echin · psiin · toray.in 与输出 toray_*.nc 四件都在盘上",
   "comment": "★**净室**：读的是 TORAY 的数据文件，从未读它的源码。★冻结件 `cfedr_toray_20ma.txt`（内核仓 `rust/tools/gen_cfedr_toray_reference.py` 生成）标 `release: internal`、取自受限语料，只在私有内核仓；本记录只记比较量。"
  }
 ],
 "criteria": [
  {
   "id": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/1",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "偏振支：|N| 在两射线同过的五个磁面上对 TORAY 的最劣相对差（所认之支 < 1 %，另一支 > 5 %）",
   "norm": "relative",
   "tolerance_basis": "measured_band",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.01
   },
   "comment": "★哪一支没有写在四件输入的任何一处——它是**量出来的**，而且两半都守：认出的那支要贴、另一支要分得开。"
  },
  {
   "id": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/2",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "射线：同一 psi_N 面上的 (R, Z) 最劣差",
   "norm": "absolute",
   "tolerance_basis": "measured_band",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 5.0
   },
   "comment": "单位 mm。★比的是**同一磁面**，不是同一序号或弧长：TORAY 的轨迹从进入等离子体处起算，本码从发射器起算。"
  },
  {
   "id": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/3",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "最深 psi_N 与 N∥（同面）的相对差",
   "norm": "relative",
   "tolerance_basis": "measured_band",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.01
   },
   "comment": "N∥ 另守 1e-3（它曾因极向场符号差 25 %，F-33 修后到 1.5e-4）。"
  },
  {
   "id": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/4",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "沉积：峰位 psi_N 之差；吸收份额 > 0.5",
   "norm": "absolute",
   "tolerance_basis": "measured_band",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.05
   },
   "comment": "★本码的壳宽 0.02，0.05 是两壳半；TORAY 的峰在它自己的 rho 上，按它自己的 xrho / xbouni 映到 psi_N。"
  },
  {
   "id": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/5",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "驱动电流每入射瓦对 TORAY 的比",
   "norm": "relative",
   "tolerance_basis": "measured_band",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.2
   },
   "comment": "带 0.9–1.2：两套独立的伴随 ECCD 实现，B 类。"
  }
 ],
 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "偏振支：O，|N| 差 3.4e-05；X 支差 23.9 %",
   "criterion": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/1",
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "五个磁面 psi_N 0.90 / 0.70 / 0.50 / 0.35 / 0.25：O 支最劣 3.41e-05，X 支最劣 0.239 → TORAY 发的是本码所称的 O 支",
   "measured_deviation": 3.414910215404632e-05
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "射线同面：R 0.36 mm、Z 0.64 mm",
   "criterion": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/2",
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "五个磁面上 |ΔR| ≤ 0.36 mm、|ΔZ| ≤ 0.64 mm（约 3.5 m 的路径）",
   "measured_deviation": 0.6434850225469635
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "最深 psi_N 0.1456 对 0.1455；N∥ 1.5e-04",
   "criterion": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/3",
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "最深 psi_N：本码 0.1456、TORAY 0.1455（8.3e-04）；N∥ 同面最劣 1.51e-04",
   "measured_deviation": 0.0008258813801895748,
   "caveat": [
    "★N∥ 这一格是这个参照**抓出过**一个真缺陷的地方：2026-09-11 以前本码的极向场少了 sigma_Bp（COCOS 17 要 −1），N∥ 系统偏低 25 %；|N| 与射线位置都对，偏的是 N 与 B 的夹角。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "沉积峰 0.210 对 0.198；吸收 1.0000 对 0.9990",
   "criterion": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/4",
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "峰位 psi_N：本码 0.2100（壳宽 0.02）、TORAY 0.1983 → 差 0.0117；吸收份额 1.0000 对 0.9990",
   "measured_deviation": 0.011686877681649971,
   "caveat": [
    "★差 0.012 不到一个壳：这一格的分辨率是本码的壳宽，不是物理。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "驱动电流每瓦 1.046 倍",
   "criterion": "benchmark/records/tr-sources-ec-toray-cfedr/criterion/5",
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "本码 1.9910e-02 A/W、TORAY 1.9031e-02 A/W → 比 1.0462（Zeff 取 TORAY 在沉积峰处的 1.999）",
   "measured_deviation": 0.0461744620645117,
   "caveat": [
    "★单束、单一设计点：这一格说两套伴随 ECCD 在一个点上差 4.6 %，不说它在别处也这么近——对 METIS 认证库的散布（0.03–0.64）见 `tr-sources-eccd-metis`。"
   ]
  }
 ],
 "validity_domain": "CFEDR H-mode 20 MA 设计点，TORAY 那一束（频率、功率、发射位置与两角取自其 echin / toray.in，角度约定由发射点到射线首点的弦**推出**并由内核测试校验）；平衡取 psiin（SI），剖面取 echin 的 201 点。★只有这一束、这一个点。",
 "caveat": [
  "★★**对拍不是验证**：两个码在一个点上吻合，说明两家描述的是同一个等离子体，不说明任何一家对。",
  "★参考侧不在本处重跑：TORAY 的输出是冻结件，sha256 记在其头部（nc · echin · psiin · nml · state）。"
 ],
