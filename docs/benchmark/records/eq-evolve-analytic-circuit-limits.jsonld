  "type": "spo:Code",
  "name": "fylite",
  "comment": "内核门 code/evolve_free_boundary，经 tools/benchmark-evolve-free-boundary.py；EAST 牌"
 },
 "compared_reference": [
  {
   "type": "spo:InformationContentEntity",
   "name": "纯电路问题的解析解（壳模衰减 e^(-t/tau_w) · 理想导体磁通冻结）",
   "comment": "★★**参考是解析解，不是另一个码**——所以这是验证，容差取舍入级而不是物理带。★这两条恒等式的妙处在于它们**不需要等离子体**：把等离子体拿掉，剩下的电路问题有闭式解，接线错了当场就现形。带等离子体之后没有解析解可依，那一层由别的记录（对拍类）担。"
  }
 ],
 "criteria": [
  {
   "id": "benchmark/records/eq-evolve-analytic-circuit-limits/criterion/1",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "壳模衰减对解析 e^(-t/tau_w) 的最劣相对偏差",
   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 1e-12
   },
   "tolerance_basis": "machine_precision",
   "comment": "★带 1e-12 已是实测值（~1e-15）的千倍：恒等式在舍入以内成立，带只是防劣化的护栏。"
  },
  {
   "id": "benchmark/records/eq-evolve-analytic-circuit-limits/criterion/2",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "理想导体的磁通漂移 / 它被移动的量",
   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 1e-10
   },
   "tolerance_basis": "machine_precision",
   "comment": "★分母取「被移动的量」而不是磁通本身：等离子体不爬升时分子分母同为零，拿磁通作分母会让这条判据在什么都没发生时也显示完美。"
  },
  {
   "id": "benchmark/records/eq-evolve-analytic-circuit-limits/criterion/3",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "回路方程的最大残差（磁通冻结 / 电压驱动 / 电流驱动 三档）",
   "norm": "absolute",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 1e-09
   },
   "tolerance_basis": "machine_precision",
   "comment": "解到自由边界解自身的容差 1e-9"
  },
  {
   "id": "benchmark/records/eq-evolve-analytic-circuit-limits/criterion/4",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "电压驱动与电流驱动两条路复现同一段壳电流的最劣相对差",
   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 4.51e-09
   },
   "tolerance_basis": "measured_band",
   "comment": "★这是一条**交叉检验**：同一段演化用两种驱动方式走，应当到同一处。"
  },
  {
   "id": "benchmark/records/eq-evolve-analytic-circuit-limits/criterion/5",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "每一耦合步都是电流自身的一个已收敛平衡",
   "norm": "absolute",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 2.0
   },
   "tolerance_basis": "machine_precision",
   "comment": "★gs_state == 2 且 fb_held == 0：演化不是「解一次然后外推」，每步都真的解了。这一条没有数值容差可言，但它守的东西比任何一条带都重要。"
  }
 ],
 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "壳模衰减对解析解",
   "criterion": "benchmark/records/eq-evolve-analytic-circuit-limits/criterion/1",
   "deviation_literal": "最劣相对偏差 8.44e-15（判据 1e-12，余量约 119 倍）",
   "verdict": "pass",
   "caveat": [
