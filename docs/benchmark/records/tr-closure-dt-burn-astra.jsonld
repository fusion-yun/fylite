  "zh": "DT 燃烧的 α 加热：份额对分支比、总量对 ASTRA，以及内核不给的那一项",
  "en": "D-T alpha heating: the branching share, the total against ASTRA, and the split the kernel does not give"
 },
 "domain": "tr-closure",
 "requirement": [
  "FR-TR-004"
 ],
 "comparison_kind": "benchmark",
 "overall_verdict": "inconclusive",
