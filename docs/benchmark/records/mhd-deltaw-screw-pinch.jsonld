 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "五组 $(m,k)$、200 点：两式最劣相对 1.6e-13",
   "criterion": "benchmark/records/mhd-deltaw-screw-pinch/criterion/1",
   "measured_deviation": 1.631e-13,
   "bound": "upper",
   "deviation_literal": "五组 $(m,k)$、200 点：两式最劣相对 1.6e-13",
   "verdict": "pass",
   "caveat": [
    "★**不是「二阶消失」而是舍入**：上游的两式差随网格二阶消失，是因为它对剖面做数值求导；这里剖面带解析导数进来，(17)、(18) 逐点只差舍入。判据要的「两处转录同时钉死」照样成立——任一处抄错都会在 1e-13 这一层露出来。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★★Λ 式对 $(f,g)$ 式 2.1e-15；FEM 能量误差比 3.999 / 4.000 / 4.000",
   "criterion": "benchmark/records/mhd-deltaw-screw-pinch/criterion/2",
   "bound": "identity",
   "deviation_literal": "对两端为零的 ξ：$(\\pi/2)\\int r\\Lambda\\,dr$（Eq. 14，Λ 取 Eq. 9）对 $(\\pi/2)\\int(f\\xi'^2+g\\xi^2)dr$（Eq. 15–17）四组 $(m,k)$ × 两式 **最劣 2.1e-15**；节点插值的 FEM 能量对精确积分 50 · 100 · 200 · 400 单元 2.74e-4 · 6.85e-5 · 1.71e-5 · 4.28e-6",
   "verdict": "pass",
   "caveat": [
    "★★**绝对尺换了一条路**：上游用 SymPy 的精确符号 $f,g$ 做绝对尺；本仓没有 SymPy，改用原文**另一处**转录——Eq. (9) 的 Λ——作见证。两式只在分部积分后相等，任一处抄错都破坏它。",
    "★★**它当场抓到了一处真错**：我初版把 Eq. (9) 前置的 $1/(k^2r^2+m^2)$ 也作用到了第二项上，两边差 **3.5 倍**；看原文排版，那个分母只管第一项的平方——与 (17) 里 $(krB_z+mB_\\theta)^2/r$ 不带分母一致。改后 2.1e-15。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "α 两式 1.1e-15；(33) 恒等式 1.6e-16",
   "criterion": "benchmark/records/mhd-deltaw-screw-pinch/criterion/3",
   "measured_deviation": 1.64e-16,
   "bound": "upper",
   "deviation_literal": "四组 $(m,k)$ 在各自奇异面上（二分到机器精度）",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★无剪切：Suydam 左端逐点等于 $P'$；有剪切对照 $P'=-5.1\\times10^{-3}<0$ 而左端 $+3.5\\times10^{-2}$；$f$ 在奇异面上 < 1e-12、别处 ≥ 0；纯轴向场五组 $(m,k)$ 全稳，带电流 $m=1,k=-0.8$ 的 λ = −0.550",
   "criterion": "benchmark/records/mhd-deltaw-screw-pinch/criterion/4",
   "bound": "identity",
   "deviation_literal": "无剪切：Suydam 左端逐点等于 $P'$；有剪切对照 $P'=-5.1\\times10^{-3}<0$ 而左端 $+3.5\\times10^{-2}$；$f$ 在奇异面上 < 1e-12、别处 ≥ 0；纯轴向场五组 $(m,k)$ 全稳，带电流 $m=1,k=-0.8$ 的 λ = −0.550",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "两组 $(m,k)$：本征向量上的 $W$ 与 λ 同号，Rayleigh 商等于 λ 到 1e-8",
   "criterion": "benchmark/records/mhd-deltaw-screw-pinch/criterion/5",
   "bound": "identity",
   "deviation_literal": "(1,−0.8)：λ −0.550、W −6.3e-4；(1,−0.2)：λ 1.980、W 1.4e-3",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "四种都按名拒绝；「未知 form」在 Rust 里**编不过**（`GForm` 只有两个变体）",
   "criterion": "benchmark/records/mhd-deltaw-screw-pinch/criterion/6",
   "bound": "identity",
   "deviation_literal": "四种都按名拒绝；「未知 form」在 Rust 里**编不过**（`GForm` 只有两个变体）",
   "verdict": "pass",
   "caveat": [
    "★SI 入口：只有压强要换。忘乘 μ₀ 的 $dP/dr$（−1.2e6 对 −1.54）不满足平衡 (2)，被当作「不是平衡」拒绝——静默的错变成了响的错。"
   ]
  }
 ],
 "validity_domain": "柱位形、单 $(m,k)$、无环效应；环状箍缩 $a<r<b$（$r=0$ 不在网格内），$\\xi(a)=\\xi(b)=0$。★交付的是**边缘稳定性**：没有动能归一，λ 的数值不是 $\\omega^2$。",
 "caveat": [
  "★★**判决成立**：六格全过。第一格的「二阶消失」以「逐点只差舍入」达成（解析导数），第二格的绝对尺改由 Eq. (9) 见证——并当场抓到了一处转录错。",
  "★门在内核仓，本仓 CI 跑不到。"
 ],
