 "type": "fyo:ComparisonRecord",
 "title": {
  "zh": "动理学自洽外环：把**故意给错的映射**交给它，看它拉不拉得回来",
  "en": "The kinetic outer loop: hand it a deliberately wrong mapping and watch it come back"
 },
 "domain": "eq-reconstruct",
 "requirement": [
  "FR-EQ-010"
 ],
 "comparison_kind": "verification",
 "overall_verdict": "pass",
 "compared_subject": {
  "type": "spo:Code",
  "name": "fylite · code/reconstruction（kinetic_passes = 6）",
  "comment": "逐遍把动理学测点 (R, Z) 重映到 psi_N，再解一次"
 },
 "compared_reference": [
  {
   "type": "spo:InformationContentEntity",
   "name": "同一次孪生的**已知真映射**，以及单遍（kinetic_passes = 1）的结果",
   "comment": "★★**这是本册里少有的一条「真值已知」的重构判据**：动理学测点造在真值 psi 图的中平面上，所以「它们该落在哪个 psi_N」是算出来的、不是猜的。于是可以**故意给错**，再看外环拉不拉得回来。"
  }
 ],
 "criteria": [
  {
   "id": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/1",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "外环收官时 q0 相对真值的偏差",
   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.005
   },
   "tolerance_basis": "reference_self_reported",
   "comment": "★带取 0.5 %：映射给错 0.12 时单遍的 q0 偏差是 7.1 %，而本域另一条（可观测空间）在映射**没给错**时量到的 q0 偏差是 0.12 %。0.5 % 是「外环该把大部分伤害消掉」的一个有原则的界，不是贴在 0.070 % 上。"
  },
  {
   "id": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/2",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "收官那一遍的映射移动（psi_N）",
   "norm": "absolute",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 0.005
   },
   "tolerance_basis": "reference_self_reported",
   "comment": "★★**这一格判的是「自洽」二字本身**：映射还在走，就说明剖面挂的面还不是解出来的那个。带取 0.005，约是初始错量 0.12 的 1/20。"
  },
  {
   "id": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/3",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "外环相对单遍的改善倍数（q0 偏差之比）",
   "norm": "relative",
   "tolerance": {
    "type": "spo:QuantityValue",
    "numeric_value": 5.0
   },
   "tolerance_basis": "measured_band",
   "comment": "★★**下限格，也是本条的要害**。一个总能收敛的循环说明不了什么——要紧的是它**真的修好了东西**。没有这一格，「跑了六遍」只是一句话。"
  },
  {
   "id": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/4",
   "type": "fyo:AcceptanceCriterion",
   "quantity_label": "★证书是否逐遍出（chi2/dof 与映射移动两条迹）",
   "norm": "identity",
   "tolerance_basis": "reference_self_reported",
   "comment": "★抄录原文：「`kinetic_outer` 证书含逐遍 chi2/dof 与映射移动；最优遍收官」。**证书才是交付物，不是循环。**"
  }
 ],
 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "★★错映射被拉了回来",
   "criterion": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/1",
   "measured_deviation": 0.0007030280150454038,
   "bound": "upper",
   "deviation_literal": "把每个测点的 psi_N 标签**故意推错 +0.12**，单遍给出 q0 偏差 +7.116e-02，六遍外环给出 -7.030e-04（带 0.5 %）",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "映射settle下来了",
   "criterion": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/2",
   "measured_deviation": 0.0030752836925662663,
   "bound": "upper",
   "deviation_literal": "逐遍移动 0.2345 → 0.1505 → 0.0390 → 0.0113 → 0.0031 → 0.0008 —— 从 0.2345 单调降到 8.48e-04",
   "verdict": "pass",
   "caveat": [
    "★★**单遍那一次也报了它自己的映射移动（0.2345）**——也就是说，一个不跑外环的调用方也会被告知「你这个解不自洽到这个程度」。★这是证书最实用的一面：**它不需要你跑外环才肯说话。**"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★它真的修好了东西",
   "criterion": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/3",
   "measured_deviation": 101.21757908679812,
   "bound": "lower",
   "deviation_literal": "q0 偏差改善 101 倍（7.116e-02 → -7.030e-04）；动理学行的 chi2 从 8.3611 到 0.0081007（1032 倍）；整体 chi2/dof 从 0.81034 到 0.0052682（154 倍）",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★★证书逐遍出，而且「取最优遍」当场就用上了",
   "criterion": "benchmark/records/eq-reconstruct-kinetic-outer/criterion/4",
   "bound": "identity",
   "deviation_literal": "逐遍 chi2/dof 0.81034 → 0.11172 → 0.012872 → 0.0060604 → 0.0052682 → 0.0052892；收官于第 5 遍（共 6 遍）",
   "verdict": "pass",
   "caveat": [
    "★★**第 6 遍比第 5 遍差（0.00528919 对 0.00526821），于是它收官在第 5 遍。**「取最优遍不取最后一遍」这条规则是照着「交替不保证单调」写的防御，而它**在第一次真实测试里就触发了**——不是纸上的谨慎。门也把这件事写进了 notes。",
    "★`kinetic_map_shift` 报的是**收官那一遍**的移动，不是最后一遍的：读者要判的是手上这个解自洽到什么程度；整条迹在 `kinetic_pass_map_shift` 字段里。"
   ]
  }
 ],
 "validity_domain": "EAST #137985 t = 4.041 s 的孪生。动理学测点取真值磁轴同高度的中平面上 9 个点（R = 1.742 .. 2.142 m），读数按真值压强剖面给，sigma 取峰值的 5 %。★初始 psi_N 标签**故意整体推错 +0.12**。外环上限 6 遍、`kinetic_tol` = 1e-4。★**测点是造出来的，不是测出来的**——本条验的是外环这台机器，不是某台装置的汤姆逊系统。",
 "caveat": [
  "★★**为什么能这样验**：真值平衡自己带压强剖面，测点造在它的 psi 图上，于是「该落在哪个 psi_N」是**算得出来的**。本册里大多数重构判据没有这个便利——★这也提醒：本条证明的是**外环能纠正映射误差**，不是「重构准」。后者是别的记录的事。",
  "★**它不保证单调**，记录里那条 chi2/dof 迹自己就是证据（第 6 遍回升）。所以「最优遍收官」不是可有可无的修饰。",
  "★真值与测量同出 fylite 自己的前向解，所以与本域另两条一样，它只能声称「反演与前向互为逆」那一层。"
 ],
