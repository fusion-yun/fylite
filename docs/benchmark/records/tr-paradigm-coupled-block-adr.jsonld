 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "★已裁：整体求解，且为缺省（2026-09-19，用户）",
   "criterion": "benchmark/records/tr-paradigm-coupled-block-adr/criterion/1",
   "bound": "identity",
   "verdict": "pass",
   "deviation_literal": "用户：「决定要整体求解」；随后选定「替换为缺省（旧路径留作 sequential 对照）」与「本轮第一 + 第二段」。设计册 `FYL-SDD-06` v1.1 含时演化 1.5-D 档记入同一裁定",
   "caveat": [
    "★此前本条判 inconclusive，理由是「上游未裁、判 fail 等于说 fylite 没做到一件从没被要求的事」。裁定来了，这一格就有了对象。",
    "★裁定在本仓落地，**上游 `FYTOK-SRS-04` 的证据栏仍写着候选 ADR（[TBD]）**——抄录件不改，改它是上游的事。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★★耦合一步即各通道隐式方程的同时解：不动点残差 1.7e-13（旧的两遍顺序解 2.2e-02）",
   "criterion": "benchmark/records/tr-paradigm-coupled-block-adr/criterion/2",
   "measured_deviation": 1.7e-13,
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "构造算例（21 点，Te/Ti，非线性汇 q_e = P − c Te^1.5，交换 ν = 20 /s，dt = 10 ms）：耦合步 15 遍收敛（末遍 9.9e-13），以解处的源再解一次隐式步，回到同一解 1.7e-13（判据 1e-9）。同一步用旧路径（固定两遍、交换取值）离它 2.2e-02——那是**每步 2 % 的分裂误差**",
   "caveat": [
    "★★「整体求解」在这里的确切含义：**线性于未知量的耦合**（碰撞交换 $k(T_e-T_i)$）进块矩阵，同一个线性系统里解；**非线性的耦合**（α 加热对 T_i、辐射对 T_e、欧姆对 ψ 与 σ、自举与新经典 χ 对 q）逐遍在当前迭代值上重算，遍数迭代到收敛。收敛的一步满足的就是全体通道后向 Euler 方程的同时解——Picard 与 Newton 收敛到同一个点，差在走多少遍（Newton 延后）。",
    "★辐射作**隐式汇** $g=P(T_k)/(\\tfrac32 n_e e T_k)$ 进对角：不动点处恰为 $P$，且不会把 T 推到零下（显式减时，一个氩物种算例的迭代值被推到 −60 eV）。",
    "★欧姆功率取**本步**的 $\\partial\\psi/\\partial t$ 与本遍电导率（此前是上一步的，滞后整一步）；自举 / 新经典取推进自己的 q（此前固定为 `q_init`）。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "耦合对的账：每道 9.0e-16（按实际施加的交换）",
   "criterion": "benchmark/records/tr-paradigm-coupled-block-adr/criterion/3",
   "measured_deviation": 8.99e-16,
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "隐式交换：两道各自的能量账按新温度上的交换 k(Te−Ti) 记，最劣 9.0e-16（判据 1e-3）；ITER 15 MA 全程最劣步 1.6e-13。★此前（顺序对）：离子得 1.248302e+01 · 电子付 1.248302e+01，相对差 9.563e-14",
   "caveat": [
    "★守恒是**构造**出来的：两行的交换项乘回各自的热容就是 $\\pm V' k (T_e-T_i)$，同一节点、符号相反——不是事后检查出来的。",
    "★带没有收紧到实测值，理由同前：1e-3 是这条物理不变量该有的工程界。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "无耦合即旧解：块解对稠密解 < 1e-13、k = 1 逐位即 Thomas、无交换逐位即顺序对",
   "criterion": "benchmark/records/tr-paradigm-coupled-block-adr/criterion/4",
   "bound": "identity",
   "verdict": "pass",
   "deviation_literal": "17 节点 × 3×3 块的块三对角系统对稠密 LU < 1e-13；k = 1 的块解与标量 Thomas 逐位相同；k = 0 时耦合步的 Te / Ti 与旧的顺序对逐位相同。★旧路径以 `sequential = 1` 保留：ITER 15 MA 上逐位复现旧读数（P_α 7.29541e7 W）",
   "caveat": [
    "★`step_theta` 的逐迭代装行抽成一处（`theta_rows`），单通道与耦合步共用——transport 的 81 条既有测试原样过，逐位。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "隐式交换在 40 倍显式上限的 dt 上：按后向 Euler 精确弛豫；显式交换同 dt 翻号",
   "criterion": "benchmark/records/tr-paradigm-coupled-block-adr/criterion/5",
   "bound": "identity",
   "verdict": "pass",
   "deviation_literal": "ν = 1e3 /s、dt = 1e-2 s（显式上限 0.25/ν 的 40 倍）：中点 Te−Ti 由 2000 eV 到 95.238 eV，恰为 2000/(1+2νdt) = 95.238 eV，不变号；同 dt 的顺序对（交换取步首值）Te−Ti 翻到 −1000 eV 以下",
   "caveat": [
    "★★**dt 上限（0.25/ν）在 `code/evolve` 里两条路径都保留，照实记**：对交换它已不需要，但它此前一直兼作刚性边缘辐射 / 电离的稳定护栏——撤掉后一个氩物种算例（1.6 ms 步）的边缘点在遍间陷入四态循环（Te 0.4–3 eV），电荷态拟合拒绝。撤它要阻尼或 Newton 的遍（第三段，延后），不是更大的步。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "ITER 15 MA：每步 5 遍、全部收敛（末遍最劣 2.6e-11）；与旧路径差 P_α +1.6 %、轴 Te +0.6 %",
   "criterion": "benchmark/records/tr-paradigm-coupled-block-adr/criterion/6",
   "measured_deviation": 2.6136365840619113e-11,
   "bound": "upper",
   "verdict": "pass",
   "deviation_literal": "evolve-iter-15ma（31 点，400 步）：耦合路径每步 5–5 遍，末遍相对变化最劣 2.6e-11（判据 1e-9），未收敛步 0；P_α 7.41298e+07 W、轴 Te 23270.3 eV、能量账 1.6e-13。旧的顺序对：每步 2 遍（不迭代），P_α 7.29541e+07 W、轴 Te 23123.0 eV。差 P_α +1.61 %、轴 Te +0.64 %——α 加热与交换在步内反馈，而不是滞后",
   "caveat": [
    "★★**不是每个算例每一步都收敛，照实记**：一个带氩的物种算例（内核 `case::tests` 的物种三例）里个别步 40 遍到顶、末遍 4e-4——边缘刚性的辐射 / 电离在 Picard 遍间来回。那一步仍是隐式解、账按末遍的源闭合，只是不在不动点上；门在 `coupling_delta` 里报出来。治它是阻尼或 Newton（延后）。",
    "★源项公式里的**密度因子**仍取步首成分（温度与 ψ 的依赖已进迭代）；C ABI 的可续推进面（`fylite_rs_core_march_*`）仍交交换值，是顺序对。"
   ]
  }
 ],
 "validity_domain": "内核 `transport` 的构造算例（块解、隐式交换、不动点）与 `evolve-iter-15ma`（ITER 15 MA，31 点，400 步，定 χ）。★判的是「整体求解做对了没有」——一步是不是各通道隐式方程的同时解、账是否闭合、不耦合时是否退回旧解；不判输运物理本身。",
 "caveat": [
  "★★**本条由 inconclusive 转 pass（2026-09-19）**：缺的是一个决定，决定来了（用户「决定要整体求解」），实现与判据随之落地。",
  "★本轮做到第二段（块解 + 隐式交换；全通道迭代到收敛，α · 辐射 · 欧姆 · q 进迭代）。**没做的照记**：Newton（第三段）、撤 dt 上限、源项密度因子进迭代、C ABI 可续面的耦合。",
  "★本条不覆盖 `FR-TR-001` / `FR-TR-002` 的架构缺口，那两处另有记录（`tr-equations-boundary-family`）。"
 ],
