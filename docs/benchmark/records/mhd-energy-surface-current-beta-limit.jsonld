 "title": {
  "zh": "表面电流模型的解析 β 极限：**根是 1.69，而 0.21 属于 1.71**",
  "en": "The surface-current model's analytic beta limit: the root is 1.69, and 0.21 belongs to 1.71"
 },
 "domain": "mhd-energy",
 "requirement": [
  "FR-EQ-021"
 ],
 "comparison_kind": "verification",
 "overall_verdict": "pass",
 "compared_subject": {
  "type": "spo:Code",
  "name": "fylite · `stability::surface_current_mlp` / `surface_current_w_matrix` / `surface_current_w` / `surface_current_q_crit` / `surface_current_low_beta`",
  "comment": "2026-09-18 新写：Freidberg §12.8 三谐波（m = 1, 2, 3；n = 1）的表面电流模型"
 },
 "compared_reference": [
  {
   "type": "spo:InformationContentEntity",
   "name": "Freidberg, *Ideal MHD* (Cambridge, 2014), §12.8, Eqs. (12.154)–(12.166)",
   "comment": "书印的 $M_{lp}$ 分数、(12.164) 右端两三位的数值系数、根 1.69、β/ε ≈ 0.21（在 20 谐波的 $q_{crit}=1.71$ 上）、低 β 极限 (12.156) 与 Kruskal–Shafranov (12.157)。★这是 L2 的 **oracle**，不是 L2 本体。"
  }
 ],
