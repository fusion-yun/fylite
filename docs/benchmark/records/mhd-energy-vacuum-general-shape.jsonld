 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "10 个谐波的随机 $g$、三种半径，$N=64$：1.9e-15",
   "criterion": "benchmark/records/mhd-energy-vacuum-general-shape/criterion/1",
   "measured_deviation": 1.915e-15,
   "bound": "upper",
   "deviation_literal": "$N=64$，$a$ = 0.5 · 1 · 2，$m$ = 1…10 的随机系数",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★$b/a$ = 4 · 2 · 1.5 · 1.2 × $m$ = 1–5，$N=256$：2.4e-14；★近壁要足够的分辨率",
   "criterion": "benchmark/records/mhd-energy-vacuum-general-shape/criterion/2",
   "measured_deviation": 2.354e-14,
   "bound": "upper",
   "deviation_literal": "$b/a=1.2$、$m=1$ 在 $N$ = 64 · 128 · 256 上 1.04e-4 · 8.86e-10 · 2.35e-14——每加倍降约五个量级",
   "verdict": "pass",
   "caveat": [
    "★判据字面「到 1e-15」：本条到 2.4e-14，门按 1e-13 设。",
    "★★**近壁的代价照实记**：两条曲线之间的积分越近越奇，梯形误差按 exp(−间隙·N) 走。间隙 0.2、节点间距 0.059 时 $N=128$ 只到 8.9e-10——初版按 $N=128$ 设门，就在这里红了。**不是实现错，是分辨率不够**；这条收敛本身钉成了测试。",
    "★$f_m$ 以负幂实现：$|m|=1000$、$\\rho_w=1.01$ 时有限且趋于 1，不溢出；$\\rho_w\\to\\infty$ 给 1，$\\rho_w\\to1^+$ 发散。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "$b/a=100$ 对无壁多 1.8e-4；$b/a$ 从 100 到 1.1 能量单调升 5.57 → 54.5",
   "criterion": "benchmark/records/mhd-energy-vacuum-general-shape/criterion/3",
   "bound": "identity",
   "deviation_literal": "无壁 5.5654；$b/a$ = 100 · 8 · 4 · 2 · 1.5 · 1.2 · 1.1 → 5.5664 · 5.7207 · 6.2208 · 8.8936 · 13.649 · 28.805 · 54.533",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "强 D 形（κ1.7 δ0.5）6 组 $g$：能量最小 0.658 > 0；二次性 1.0e-15；V 加常数不改能量",
   "criterion": "benchmark/records/mhd-energy-vacuum-general-shape/criterion/4",
   "measured_deviation": 1.012e-15,
   "bound": "upper",
   "deviation_literal": "二次性：$E(-3g)$ 对 $9E(g)$ 最劣 1.0e-15；规范：$V+7$ 给同一能量到 1e-12",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★强 D 形 $g=n_x$：$N$ = 32 → 64 → 128 → 256 逐档差 4.8e-11 · 6.2e-15 · 2.2e-14；对同半径圆差 2.9",
   "criterion": "benchmark/records/mhd-energy-vacuum-general-shape/criterion/5",
   "bound": "identity",
   "deviation_literal": "4.504996430739 · …690 · …690 · …690；圆为 π/2",
   "verdict": "pass",
   "caveat": [
    "★★**变形位形上另有一条解析锚**（判据没点名）：椭圆 $b/a=1.7$、$g=n_x$ / $n_y$ 就是椭圆的势流绕流，能量等于附加质量 $\\pi b^2/2$ / $\\pi a^2/2$。$N=32$ 起即 **1e-15 量级**——所以「变形位形」不只有自收敛可看。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★D 形上 $\\oint\\cos t\\,ds=0.590$ → 按名拒绝；圆上同一数据合法",
   "criterion": "benchmark/records/mhd-energy-vacuum-general-shape/criterion/6",
   "bound": "identity",
   "deviation_literal": "常数 $g$ 拒绝；顺时针拒绝（不翻转）；壁与面相交、壁在里面拒绝；点数非 2 的幂拒绝",
   "verdict": "pass",
   "caveat": [
    "★「参数上的纯余弦」在**左右对称**的椭圆上仍碰巧合法（$|x'|$ 关于 $t\\to\\pi-t$ 对称），所以这条要在 D 形上钉——在椭圆上钉就是一条永远过的门。"
   ]
  }
 ],
 "validity_domain": "任意光滑、逆时针、按 2 的幂采样的闭曲线；真空为二维 Laplace（大环径比，与 Eq. 12.149 同阶）；理想壁须包住等离子体面且不相交。",
 "caveat": [
  "★★**判决成立**：六格全过；第二格的「1e-15」以 2.4e-14 达到，并记明近壁需要的分辨率。",
  "★δW_V 的这一版与 `FR-EQ-022` 的 δW_F、`FR-EQ-024` 里的 δW_S 一起，使 L2 三项**都可对一般位形求值**；装起来之后怎样，见 `FR-EQ-024`。"
 ],
