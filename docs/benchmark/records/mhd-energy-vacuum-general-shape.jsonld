 "type": "fyo:ComparisonRecord",
 "title": {
  "zh": "一般位形的真空扰动能 δW_V：**同心圆壁复现 f_m，椭圆复现附加质量——两条都与实现不共享中间量**",
  "en": "Vacuum perturbation energy for a general shape: a concentric wall reproduces f_m and an ellipse reproduces its added mass — neither shares an intermediate with the implementation"
 },
 "domain": "mhd-energy",
 "requirement": [
  "FR-EQ-023"
 ],
 "comparison_kind": "verification",
 "overall_verdict": "pass",
 "compared_subject": {
  "type": "spo:Code",
  "name": "fylite · `vacuum::Curve` / `vacuum_energy`",
  "comment": "2026-09-18 新写：单层位势 + Kress 对数分裂的 Nyström，理想壁作第二条边界联立；推广到任意曲线为本仓自推"
 },
 "compared_reference": [
  {
   "type": "spo:InformationContentEntity",
   "name": "圆截面闭式 Eq. (12.150)、壁因子 $f_m$（FR-EQ-021(g)）、椭圆绕流的附加质量",
   "comment": "圆：$E=(\\pi a^2/2)\\sum(c_m^2+s_m^2)f_m/m$；$f_m=(1+\\rho_w^{-2m})/(1-\\rho_w^{-2m})$ 在 `stability::surface_current_wall_factor`，本模块里**不出现**；椭圆 $g=n_x$ 时 $\\int|\\nabla\\phi|^2dA=\\pi b^2$（势流附加质量）。"
  }
 ],
