   "deviation_literal": "定常 16 行：p_el 0.9553 – 1.0791、W_fast 0.9480 – 1.0145；未定常 20 行（排除）：0.0197 – 38.85 倍",
   "measured_deviation": 0.07909999999999995,
   "caveat": [
