 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "★J × B = ∇p 到 4.9e-16；q(0) 逐位回收；q(1) = 0.523027 对椭圆积分闭式逐位相同，对印值 0.5224 高 0.12 %",
   "criterion": "benchmark/records/mhd-deltaw-toroidal-fixed-boundary/criterion/1",
   "bound": "identity",
   "deviation_literal": "Kerner 坐标下映射解析：$X=(1+2\\varepsilon\\rho\\cos\\vartheta)^{1/2}$、$D=E\\varepsilon^2\\rho/X^2$，于是 $q(\\rho)=q_0\\langle(1+2\\varepsilon\\rho\\cos\\vartheta)^{-3/2}\\rangle$——与 E 无关（Table I：0.5224/0.3 = 2.0897/1.2）",
   "verdict": "pass",
   "caveat": [
    "★印值系统性低 0.11–0.12 %，**六行同一比值**（1.0011–1.0012）——是印表时 $q(s)$ 的求法之差，不是平衡转录之差：本条的 $q(1)$ 与 $\\oint(1+a\\cos)^{-3/2}=4E(k^2)/((1-a)\\sqrt{1+a})$ 逐位相同。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★★环码 ω² −5.360 对柱码（m = 1）−5.415，差 1.0 %",
   "criterion": "benchmark/records/mhd-deltaw-toroidal-fixed-boundary/criterion/2",
   "measured_deviation": 0.01014,
   "bound": "upper",
   "deviation_literal": "Chance §4A：ε = 1/20、E = 1、q(0) = 0.08519、n = 10；两内核独立实现、独立签核",
   "verdict": "pass",
   "caveat": [
    "★上游记的是 −4.94 对 −4.57（15 % 内）；本条两路到 1 %。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★★第三行 0.4314（带 [0.413, 0.431]，比带顶高 0.1 %）；第四行 0.1199（带内）；两行都自下单调收敛",
   "criterion": "benchmark/records/mhd-deltaw-toroidal-fixed-boundary/criterion/3",
   "measured_deviation": 0.001,
   "bound": "upper",
   "deviation_literal": "第三行：m 加宽 0.4071 → 0.4308 → 0.4314，640 单元 0.4308；第四行：0.1020 → 0.1169 → 0.1199，640 单元 0.1199",
   "verdict": "pass",
   "caveat": [
    "★★**伪模，照实记**：径向网格对谐波宽度不够时（80 单元、|m| ≤ 12）第四行出一个 0.225 的假本征值，320 单元即消失。「加谐波」必须配「加径向单元」。",
    "★★**混叠**：极向 64 点、m ∈ [−12, 16] 时第三行跳到 1.009、反 Hermite 部分升到 5.6e-5；128 点即回到 0.4306。现在 `n_th < 4M` 按名拒绝。",
    "★第三行比 ERATO 的 0.431 高 0.1 %——带宽本身就是码间分歧，判据容差 5 %。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★B·∇θ* 逐点对 $RB_0/(X^2q)$；θ* 取反即 `TOR_ORIENTATION`",
   "criterion": "benchmark/records/mhd-deltaw-toroidal-fixed-boundary/criterion/4",
   "bound": "identity",
   "deviation_literal": "取错号曾产出假本征值——静默失败的「取向符号」成员",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "n_th < 4M、非 2 的幂、m 区间反、ρ₀ 越界、非整数 n、ε >= 0.5 都按名拒绝",
   "criterion": "benchmark/records/mhd-deltaw-toroidal-fixed-boundary/criterion/5",
   "bound": "identity",
   "deviation_literal": "n_th < 4M、非 2 的幂、m 区间反、ρ₀ 越界、非整数 n、ε >= 0.5 都按名拒绝",
   "verdict": "pass"
  }
 ],
 "validity_domain": "Solov'ev 平衡（Chance 1978 Eq. 3–5）、定形边界（Λ = 1）、γ = 5/3、ρ 常数（与上游核准的口径同）。★V5 两行的门在 `cargo test --release` 下跑（debug 下标记忽略：重）。",
 "caveat": [
  "★★**判决成立**：五格全过。**本条是对拍，不是验证**：落进五码带只说明没有明显算错。",
  "★离散照搬 `FR-EQ-028` 的教训：ξ^ρ 线性元、另两分量逐单元常值且在 Q 与 ∇·ξ 里不带 ρ 导数、能量取单元中点——没有这一条会锁死。",
  "★门在内核仓，本仓 CI 跑不到。"
 ],
