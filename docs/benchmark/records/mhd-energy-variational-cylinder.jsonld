 "findings": [
  {
   "type": "fyo:ComparisonFinding",
   "title": "20 组 $(m,n)\\times b/a$ 上最劣 5.2e-7",
   "criterion": "benchmark/records/mhd-energy-variational-cylinder/criterion/1",
   "measured_deviation": 5.208e-07,
   "bound": "upper",
   "deviation_literal": "均匀电流、400 单元：$(m,n)$ = (2,1)(3,1)(3,2)(4,1) × $b/a$ = 1.2 · 1.5 · 2 · 4 · ∞，对 $(m-1+\\lambda)/n$ **最劣相对 5.208e-7**",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★四档剖面 × 有无壁，两路最劣 3.9e-7；★峰化剖面上驱动项真的参与",
   "criterion": "benchmark/records/mhd-energy-variational-cylinder/criterion/2",
   "measured_deviation": 3.91e-07,
   "bound": "upper",
   "deviation_literal": "$m/n=3/1$：$\\nu$ = 0 · 0.3 · 0.7 · 1.2 × $b/a$ = 2 · ∞，FEM 400 单元对打靶 3201 点 **最劣相对 3.91e-7**。$\\nu=0.7$ 时拿掉内部驱动项 $rV\\psi^2$，marginal 从 2.29374 移到 2.42096（**−0.127**）；$\\nu=0$ 时拿不拿掉逐位相同",
   "verdict": "pass",
   "caveat": [
    "★判据要「含峰化剖面使内部驱动项真正参与的一档」——这一句要**验**，不是假定：一个只装了边界项的实现在均匀电流上照样全对。所以另设一条测试把驱动项拿掉，看 marginal 动不动。",
    "★泛函由打靶路的 Riccati 形读出：对欧拉解分部积分，体积分恰为 $\\psi(a)^2u(a)$，于是 $\\delta W=\\psi(a)^2W(q_a)$——正是打靶路的边缘余量。质量阵 $\\int r\\psi^2dr$ 只改 λ 的刻度，不改 marginal；**λ 不是增长率**。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "★非对称 0（两条副对角线各自独立装配），且**检查能失败**：注入 1e-12 读到 1.5e-13",
   "criterion": "benchmark/records/mhd-energy-variational-cylinder/criterion/3",
   "measured_deviation": 0.0,
   "bound": "upper",
   "deviation_literal": "$\\nu$ = 0 / 0.7：非对称 **0**，$\\mathbf B$ 最小 Cholesky 主元 1.667e-5 > 0；往一条副对角线注入 1e-12 的相对错，检查读到 1.469e-13；把 $\\mathbf B$ 一个对角元翻负，主元转负",
   "verdict": "pass",
   "caveat": [
    "★「恒为零」型验收须先证其可非零：这里上下两条副对角线在同一次求积里算出、浮点运算完全相同，所以非对称**逐位为零**——那恰恰说明这条检查若不另行证明能失败，就什么也没验。"
   ]
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "误差比 4.000 / 4.000（均匀）、4.003 / 4.012（峰化）",
   "criterion": "benchmark/records/mhd-energy-variational-cylinder/criterion/4",
   "bound": "identity",
   "deviation_literal": "50 · 100 · 200 单元：均匀电流对闭式误差 4.846e-5 · 1.211e-5 · 3.028e-6；$\\nu=0.7$ 对 3200 单元 9.393e-6 · 2.347e-6 · 5.849e-7",
   "verdict": "pass"
  },
  {
   "type": "fyo:ComparisonFinding",
   "title": "共振在域内按名拒绝；在共振之下照常组装；同侧区间不给根",
   "criterion": "benchmark/records/mhd-energy-variational-cylinder/criterion/5",
   "bound": "identity",
   "deviation_literal": "$q$ 从 1.9 升到 3.8（$m/n=3$ 在域内）→ `VAR_RESONANT_INSIDE`；整条剖面在 3 之下 → 照常；$\\lambda_{min}$ 两端同号 → `VAR_NO_CROSSING`",
   "verdict": "pass",
   "caveat": [
    "★共振在**节点与每个求积点**上查：节点之间过零也要抓到。"
   ]
  }
 ],
 "validity_domain": "柱几何、单 $m$、无 $m$ 谱耦合、无环效应压强驱动——**不是** β 极限。线性元、4 点 Gauss、$\\psi(0)=0$。",
 "caveat": [
  "★★**判决成立**：五格全过。这是 L2 唯一**不依赖任何外部数据**的整体校验，环几何之前必须过。",
  "★门在内核仓，本仓 CI 跑不到——同 `FR-EQ-017` / `018`。"
 ],
