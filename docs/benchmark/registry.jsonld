    {
     "type": "fyo:ComparisonFinding",
     "title": "饱和规则 3（NMODES=1，声明式缺口）",
     "deviation_literal": "粒子 60.6–61.2 % / 能流 40.3–42.4 %，增长率 4.6e-13",
     "verdict": "unevaluated",
     "finding_kind": "declared-gap",
     "caveat": [
