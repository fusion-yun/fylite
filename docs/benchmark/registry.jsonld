     "license": "public"
    }
   ],
   "criteria": [
    {
     "id": "record/C-11/criterion/1",
     "type": "fyo:AcceptanceCriterion",
     "quantity_label": "逐通道通量（电子热 · 离子热 · 粒子）",
     "tolerance_basis": "measured_band",
     "caveat": [
      "★带在实测后定，而且**这条记录的产出就是那条带**——「代理误差有多大」正是它要回答的问题，事前给带等于事前给答案"
     ]
    },
    {
     "id": "record/C-11/criterion/2",
     "type": "fyo:AcceptanceCriterion",
     "quantity_label": "临界梯度附近的行为",
     "tolerance_basis": "measured_band",
     "caveat": [
      "★代理最可能失真的地方；只报全域平均误差会把它平掉"
     ]
    }
   ],
   "findings": [
    {
     "type": "fyo:ComparisonFinding",
     "title": "离子热通量",
     "deviation_literal": "系统性偏低约一半：−42…−53 %（八点几乎同一因子，散布 < 20 %）",
     "verdict": "pass",
     "caveat": [
      "★是**系统偏置**不是散布，可被一个常数因子改正——这对下游与「一堆随机的差」是两回事，门里分开判"
     ]
    },
