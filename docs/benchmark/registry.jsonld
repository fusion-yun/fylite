   "id": "record/C-10",
   "type": "fyo:ComparisonRecord",
   "title": "ITER 起始的线圈磁通：拿 TRANSMAK 自己的电流过本仓的装置描述",
   "comparison_kind": "validation",
   "scenario": "scenario/iter-plasma-initiation",
   "compared_subject": {
    "type": "spo:Code",
    "name": "fylite",
    "comment": "fylite: 装置描述（fydoc 装置书的 ITER pf_active A-Box：几何 · 匝数）+ 内核互感核 `mutual_filaments` / `element_filaments`"
   },
   "compared_reference": [
    {
     "type": "spo:Code",
     "name": "TRANSMAK",
     "version": "A. Kavin · K. Lobanov · A. Mineev，Final Report on Contract ITER/CT/09/4300000030（2010-09），ITER_D_3TPCKG；五个场景各自随件的线圈电流与磁通",
     "license": "restricted（ITER IDM Internal Use）"
    }
   ],
   "criteria": [
    {
     "id": "record/C-10/criterion/1",
     "type": "fyo:AcceptanceCriterion",
     "quantity_label": "起始时刻的极向磁通（用参考自己的线圈电流），5 场景 × 5 个取值半径 R = 4…8 m",
     "norm": "relative",
     "tolerance": {
      "type": "spo:QuantityValue",
      "numeric_value": 0.06
     },
     "tolerance_basis": "measured_band",
     "caveat": [
      "实测 25 点全部落在 **−1.05 % … −4.95 %**，加一档余量",
      "★★**判据在每个半径上都成立**——件里没说磁通在哪一点取，若只在一个半径上成立，那就是拟合出来的答案而不是比较"
     ]
    },
    {
     "id": "record/C-10/criterion/2",
     "type": "fyo:AcceptanceCriterion",
     "quantity_label": "偏差的**符号**（是系统偏置还是散布）",
     "tolerance_basis": "measured_band",
     "caveat": [
      "★25 点同号（全部偏低）。系统偏置可以追到原因，散布不能——两者是不同的发现，故分开判"
     ]
    }
   ],
   "findings": [
    {
     "type": "fyo:ComparisonFinding",
     "title": "起始磁通，5 场景 × 5 半径",
     "deviation_literal": "−1.05 % … −4.95 %（118Wb 内侧 −1.14 % · 118Wb 外侧 −1.77 % · 60Wb 内侧 −2.48 % · 60Wb 外侧 −2.44 % · First Plasma −1.05 %，均在 R = 6 m）",
     "verdict": "pass",
     "caveat": [
      "把参考自己的十一路电流过本仓的 ITER 线圈几何与匝数、再用内核的互感核求和；两侧唯一共享的是**电流**"
     ]
    },
    {
     "type": "fyo:ComparisonFinding",
     "title": "★★偏差是**系统的**，25 点同号",
     "deviation_literal": "25/25 偏低",
     "verdict": "pass",
     "caveat": [
      "系统偏置可追因，散布不可；门里分开判，免得哪天变成散布还继续报绿"
     ]
    },
    {
     "type": "fyo:ComparisonFinding",
     "title": "★把两个显然的嫌疑排掉了",
     "deviation_literal": "细分 2×2 → 16×16 只动 **0.25 %** 且收敛（116.21 → 116.51 Wb）；CS 匝数取 553 而非 554 只动 **0.13 个百分点**",
     "verdict": "pass",
     "caveat": [
