     ]
    },
    {
     "type": "fyo:ComparisonFinding",
     "title": "★★★磁通随时间的轨迹**不判**",
     "deviation_literal": "最合的取值半径跑到 CS 膛内（R → 2 m）",
     "verdict": "inconclusive",
