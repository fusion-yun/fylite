     "type": "fyo:ComparisonFinding",
     "title": "tglf05 谱移 E×B（T-C33，已知未关）",
     "deviation_literal": "环向应力 −2.9e-08 对上游 −6.9734（规则 1）",
     "verdict": "fail",
     "caveat": [
